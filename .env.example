# CTF Configuration
# Copy this file to .env and customize for your deployment

# Port configuration (useful for macOS users or port conflicts)
CTF_PORT=5000

# Salt for secret derivation (change this for each CTF instance!)
COMPANY_SALT=CompanyName2025

# Flag (customize per event)
FLAG=FLAG{l3g4cy_s3rv1c3s_4r3_d4ng3r0us_wh3n_f0rg0tt3n}

# Difficulty settings
BLIND_RCE=false  # Set to 'true' for Level 8 difficulty
