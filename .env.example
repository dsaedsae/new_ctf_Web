# JWT Secret Key (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=your_jwt_secret_here_change_this_in_production

# Token Signing Secret for jti validation (shared between auth and resource servers)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SIGNING_SECRET=your_token_signing_secret_change_in_production

# Base URL for OAuth callbacks
BASE_URL=http://localhost:8080
