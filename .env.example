# OAuth CTF Advanced - Environment Variables
# IMPORTANT: Copy this file to .env and generate your own secrets!

# JWT Secret - Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# Base URL - Change this to your deployment URL
# Examples:
#   Local: http://localhost:8080
#   Ngrok: https://YOUR_SUBDOMAIN.ngrok-free.app
BASE_URL=http://localhost:8080
