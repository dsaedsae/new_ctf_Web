# CTF Configuration
# Copy this file to .env and customize for your deployment

# Port configuration (useful for macOS users or port conflicts)
CTF_PORT=5000

# Salt for secret derivation (REQUIRED - change this for each CTF instance!)
# ⚠️ CRITICAL SECURITY WARNING ⚠️
# - MUST BE UNIQUE for each deployment instance
# - NEVER use predictable values like 'CompanyName2025' or 'test123'
# - Generate random: openssl rand -hex 16
# - If leaked, ALL instances with same salt are compromised
# - Example writeups use 'CompanyName2025' for demonstration only
COMPANY_SALT=

# Flag (customize per event)
# ⚠️ REQUIRED - Set your custom flag here
# Example format: MSG{your_custom_flag_here}
FLAG=

# Difficulty settings
BLIND_RCE=false  # Set to 'true' for Level 8 difficulty
