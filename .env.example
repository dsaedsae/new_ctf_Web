# CTF Configuration
# Copy this file to .env and customize for your deployment

# Port configuration (useful for macOS users or port conflicts)
CTF_PORT=5000

# Flask Secret Key (REQUIRED - must be 32 hex characters)
# ⚠️ CRITICAL SECURITY WARNING ⚠️
# - MUST BE UNIQUE for each deployment instance
# - Must be exactly 32 hex characters (0-9a-f)
# - Generate random: openssl rand -hex 16
# - If leaked, ALL instances with same secret are compromised
# - Example writeups use 'abcd1234567890ef' * 2 for demonstration only
SECRET_KEY=

# Flag (customize per event)
# ⚠️ REQUIRED - Set your custom flag here
# Example format: MSG{your_custom_flag_here}
FLAG=
