# CTF Configuration
# Copy this file to .env and customize for your deployment

# Port configuration (useful for macOS users or port conflicts)
CTF_PORT=5000

# Flask Secret Key (REQUIRED - must be 32 hex characters)
# ⚠️ CRITICAL: For CTF deployment, use the derived value below
# Derived from: SHA256("legacy-auth-service-20240115-las2024")[:32]
SECRET_KEY=b1c1085856ff83572ee849f408d1e057

# Flag (customize per event)
# ⚠️ REQUIRED - Set your custom flag here
# Example format: MSG{your_custom_flag_here}
FLAG=MSG{test_flag_here}
